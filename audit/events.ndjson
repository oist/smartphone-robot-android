{"timestamp":"2026-03-31T10:05:04Z","event_ts":"2026-03-31T10:04:47Z","repo":"oist/smartphone-robot-android","event_name":"issue_comment","action":"created","actor":"topherbuckley","run_id":"23791801877","run_attempt":"1","sender":{"login":"topherbuckley","html_url":"https://github.com/topherbuckley"},"issue":{"number":39,"title":"Gradle sync error \"Compilation is not supported for the following modules: android.\"","state":"closed","html_url":"https://github.com/oist/smartphone-robot-android/issues/39","milestone":null},"pull_request":null,"comment":{"id":4161445923,"html_url":"https://github.com/oist/smartphone-robot-android/issues/39#issuecomment-4161445923","created_at":"2026-03-31T10:04:47Z","updated_at":"2026-03-31T10:04:47Z","body":"Resolved during the `#59` cleanup sweep.\n\nThis did not turn out to be a tracked source-tree defect. The current diagnosis is a local Android Studio metadata problem where a phantom `.idea/android.iml` / `.idea/modules.xml` module named `android` appears and causes:\n\n`Compilation is not supported for the following modules: android.`\n\nOn current Android Studio, using **Remove unsupported modules and re-sync** clears the problem and it does not come back.\n\nSo I’m closing this as a local IDE metadata issue rather than a repo-code change.\n"},"milestone":null,"changes":null,"severity":"INFO","target_url":"https://github.com/oist/smartphone-robot-android/issues/39#issuecomment-4161445923","event_id":"8b071ce2148125f826eb495cfd9222282374348a76eb58bf6c80648cf4ef611f"}
